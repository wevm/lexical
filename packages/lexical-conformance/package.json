{
  "name": "lexical-conformance",
  "version": "0.0.0",
  "private": true,
  "description": "Conformance vectors generated from the JS Lexical packages, replayed by the Swift port in swift/.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "generate": "UPDATE_VECTORS=1 vitest run",
    "scenarios": "vitest run --config vitest.webkit.config.mts",
    "generate-scenarios": "UPDATE_VECTORS=1 vitest run --config vitest.webkit.config.mts",
    "bench": "node scripts/bench.mjs",
    "ledger": "node scripts/ledger.mjs",
    "check-ledger": "node scripts/ledger.mjs --check",
    "css-properties": "node scripts/css-properties.mjs",
    "html-entities": "node scripts/html-entities.mjs"
  },
  "devDependencies": {
    "@lexical/code-core": "workspace:*",
    "@lexical/devtools-core": "workspace:*",
    "@lexical/extension": "workspace:*",
    "@lexical/fast-check": "workspace:*",
    "@lexical/file": "workspace:*",
    "@lexical/hashtag": "workspace:*",
    "@lexical/headless": "workspace:*",
    "@lexical/history": "workspace:*",
    "@lexical/html": "workspace:*",
    "@lexical/link": "workspace:*",
    "@lexical/list": "workspace:*",
    "@lexical/markdown": "workspace:*",
    "@lexical/overflow": "workspace:*",
    "@lexical/plain-text": "workspace:*",
    "@lexical/rich-text": "workspace:*",
    "@lexical/selection": "workspace:*",
    "@lexical/text": "workspace:*",
    "entities": "2.2.0",
    "fast-check": "^4.10.2",
    "lexical": "workspace:*"
  }
}
